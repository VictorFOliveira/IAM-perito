<Window x:Class="IAM.Perito.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IAM-PERITO | Laboratório de Perícia Digital" Height="700" Width="1100" MinWidth="850" MinHeight="550" Background="#101827" Foreground="#EDF2FA"><Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="BorderThickness" Value="0"/></Style></Window.Resources><DockPanel Margin="24"><StackPanel DockPanel.Dock="Top"><TextBlock Text="IAM-PERITO" FontSize="30" FontWeight="Bold"/><TextBlock Text="Coleta lógica autorizada • Android USB • Evidências verificáveis" Foreground="#AAB9CE" Margin="0,3,0,20"/><WrapPanel><Button Content="Detectar dispositivo" Click="Detect_Click"/><Button Content="Buscar fotografias" Click="Scan_Click"/><Button Content="Exportar selecionadas" Click="Export_Click"/><Button Content="Cancelar" Click="Cancel_Click" Background="#475569"/></WrapPanel><TextBlock x:Name="DeviceLabel" Text="Nenhum dispositivo detectado" Margin="0,18,0,8" FontWeight="SemiBold"/><TextBlock x:Name="StatusLabel" Text="Pronto. Configure o ADB e autorize o dispositivo." Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,0,0,12"/></StackPanel><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions><DataGrid x:Name="PhotosGrid" Grid.Row="0" AutoGenerateColumns="False" Background="#1E293B" Foreground="#111827" CanUserAddRows="False" SelectionMode="Extended" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Arquivo" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Caminho no Android" Binding="{Binding RemotePath}" Width="4*"/><DataGridTextColumn Header="Classificação" Binding="{Binding Classification}" Width="2*"/></DataGrid.Columns></DataGrid><TextBox x:Name="LogBox" Grid.Row="1" Margin="0,12,0,0" Background="#0B1220" Foreground="#CBD5E1" BorderBrush="#334155" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/></Grid></DockPanel></Window>